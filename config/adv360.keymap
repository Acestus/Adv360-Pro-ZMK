#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        page_down: page_down {
            compatible = "zmk,behavior-mod-morph";
            label = "PAGE_DOWN";
            bindings = <&kp PG_DN>, <&kp PG_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        at_sign: at_sign {
            compatible = "zmk,behavior-mod-morph";
            label = "AT_SIGN";
            bindings = <&kp AT_SIGN>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        octathorpe: octathorpe {
            compatible = "zmk,behavior-mod-morph";
            label = "OCTATHORPE";
            bindings = <&kp POUND>, <&kp DOLLAR>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        ampersand: ampersand {
            compatible = "zmk,behavior-mod-morph";
            label = "AMPERSAND";
            bindings = <&kp AMPERSAND>, <&kp PERCENT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        tilde: tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "TILDE";
            bindings = <&kp TILDE>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        seven: seven {
            compatible = "zmk,behavior-mod-morph";
            label = "SEVEN";
            bindings = <&kp LEFT_BRACKET>, <&kp N7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        five: five {
            compatible = "zmk,behavior-mod-morph";
            label = "FIVE";
            bindings = <&kp LEFT_BRACE>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        three: three {
            compatible = "zmk,behavior-mod-morph";
            label = "THREE";
            bindings = <&kp RIGHT_BRACE>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        one: one {
            compatible = "zmk,behavior-mod-morph";
            label = "ONE";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        nine: nine {
            compatible = "zmk,behavior-mod-morph";
            label = "NINE";
            bindings = <&kp EQUAL>, <&kp N9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        zero: zero {
            compatible = "zmk,behavior-mod-morph";
            label = "ZERO";
            bindings = <&kp ASTERISK>, <&kp N0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        two: two {
            compatible = "zmk,behavior-mod-morph";
            label = "TWO";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        four: four {
            compatible = "zmk,behavior-mod-morph";
            label = "FOUR";
            bindings = <&kp PLUS>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        six: six {
            compatible = "zmk,behavior-mod-morph";
            label = "SIX";
            bindings = <&kp RIGHT_BRACKET>, <&kp NUMBER_6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        eight: eight {
            compatible = "zmk,behavior-mod-morph";
            label = "EIGHT";
            bindings = <&kp EXCLAMATION>, <&kp N8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&octathorpe        &ampersand      &seven     &five     &three     &one   &mo 4                                                         &mo 3            &nine  &zero   &two      &four   &six      &eight
&kp BACKSLASH      &mt COLON SEMI  &kp COMMA  &kp DOT   &kp P      &kp Y  &kp LEFT_SHIFT                                                &kp RIGHT_SHIFT  &kp F  &kp G   &kp C     &kp R   &kp L     &kp FSLH
&kp LS(LA(LCTRL))  &kp A           &kp O      &kp E     &kp U      &kp I  &mo 2           &kp LCTRL  &kp LALT      &kp LALT  &kp RCTRL  &mo 2            &kp D  &kp H   &kp T     &kp N   &kp S     &hm LS(LC(RALT)) MINUS
&mo 1              &mt DQT SQT     &kp Q      &kp J     &kp K      &kp X                             &kp LGUI      &kp RGUI                              &kp B  &kp M   &kp W     &kp V   &kp Z     &mo 1
&kp LSHFT          &kp HOME        &kp END    &kp LEFT  &kp RIGHT         &kp BSPC        &kp DEL    &kp TAB       &kp ESC   &kp ENTER  &kp SPACE               &kp UP  &kp DOWN  &tilde  &at_sign  &kp LSHFT
            >;
        };

        keypad {
            bindings = <
&trans  &kp LC(F4)  &kp LA(F12)  &kp LA(LC(TAB))  &kp LS(LC(TAB))    &kp LC(TAB)  &trans                                      &trans     &trans  &kp KP_NUM       &kp EQUAL    &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp LC(F12)
&trans  &trans      &kp LG(N7)   &kp LG(N8)       &kp LC(V)          &kp LC(C)    &trans                                      &none      &trans  &kp KP_N7        &kp KP_N8    &kp KP_N9      &kp KP_MINUS     &kp COMMA
&trans  &kp INS     &kp LG(N4)   &kp LG(N5)       &kp LG(N6)         &kp LC(INS)  &trans  &trans  &trans      &trans  &trans  &none      &trans  &kp KP_N4        &kp KP_N5    &kp KP_N6      &kp KP_PLUS      &trans
&trans  &kp LC(F5)  &kp LG(N1)   &kp LG(N2)       &kp LG(N3)         &kp LC(X)                    &trans      &trans                     &trans  &kp KP_N1        &kp KP_N2    &kp KP_N3      &kp KP_ENTER     &trans
&trans  &kp LC(C)   &kp LC(V)    &kp PAGE_UP      &kp LC(PAGE_DOWN)               &trans  &trans  &trans      &trans  &trans  &kp KP_N0          &kp LC(LS(TAB))  &kp LC(TAB)  &kp KP_DOT     &kp GRAVE        &trans
            >;
        };

        fn {
            bindings = <
&kp F12  &kp F11  &kp N7   &kp N5   &kp N3   &kp NUMBER_1  &trans                                      &trans  &kp N9  &kp F10  &kp F11  &kp F12  &kp N6  &kp N8
&trans   &trans   &kp F16  &kp F17  &kp F19  &trans        &trans                                      &trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &trans
&trans   &trans   &kp F13  &kp F14  &kp F15  &kp INSERT    &none   &trans  &trans      &trans  &trans  &none   &trans  &kp F4   &kp F5   &kp F6   &trans  &trans
&trans   &trans   &kp F10  &kp F11  &kp F12  &trans                        &tog 5      &trans                  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans
&trans   &trans   &trans   &trans   &trans                 &trans  &trans  &trans      &trans  &trans  &kp N0          &trans   &trans   &trans   &trans  &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        shortcuts {
            bindings = <
&trans  &trans  &trans  &trans           &trans       &trans  &trans                                      &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans           &trans       &trans  &trans                                      &trans  &trans      &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans           &trans       &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp INSERT  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans           &trans       &trans                  &trans      &trans                  &trans      &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &kp LC(LS(TAB))  &kp LC(TAB)          &trans  &trans  &trans      &trans  &trans  &kp N0              &trans  &trans  &trans  &trans  &trans
            >;
        };

        qwerty {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans                                      &trans  &kp NUMBER_6  &kp N7  &kp N8     &kp N9    &kp EQUAL  &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                      &trans  &kp Y         &kp U   &kp I      &kp O     &kp P      &kp BSLH
&trans     &kp A   &kp S   &kp F   &kp D   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp H         &kp J   &kp K      &kp L     &kp SEMI   &kp ENTER
&trans     &kp Z   &kp X   &kp C   &kp V   &kp B                   &trans      &tog 5                  &kp N         &kp M   &kp COMMA  &kp DOT   &kp FSLH   &trans
&trans     &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                &trans  &trans     &kp LBKT  &kp RBKT   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
